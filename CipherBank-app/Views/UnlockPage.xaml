<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherBank_app.Views.UnlockPage"
             Title="Unlock"
             BackgroundColor="{AppThemeBinding Light=#F4F6FB, Dark=#0B1020}">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">

      <Label Text="CipherBank" FontFamily="SpaceGroteskBold" FontSize="28" />
      <Label Text="{Binding CoraLine}" />
      <Entry Text="{Binding Pin}" IsPassword="True" Keyboard="Numeric" Placeholder="PIN" AutomationId="UnlockPinEntry" />
      <Label Text="{Binding Error}" TextColor="IndianRed" AutomationId="UnlockErrorLabel" />
      <Button Text="Unlock" Command="{Binding UnlockCommand}" AutomationId="UnlockButton" />
      <Button Text="Use biometrics" Command="{Binding UnlockWithBiometricsCommand}" IsVisible="{Binding BiometricsAvailable}" AutomationId="UnlockBiometricButton" />

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
