<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CipherBank_app.Controls"
             x:Class="CipherBank_app.Views.SendPage"
             Title="Send"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
  <Grid>
  <ScrollView>
    <VerticalStackLayout Padding="20,20,20,110" Spacing="14">
      <controls:GlassCard>
        <controls:GlassCard.Body>
          <VerticalStackLayout Spacing="10">
            <Label Text="Recipient" FontAttributes="Bold" />
            <Picker Title="Saved payees" ItemsSource="{Binding Recipients}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedRecipient}" />
            <Entry Text="{Binding Recipient}" Placeholder="Or type recipient" />

            <Label Text="Add ACH payee" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry Text="{Binding NewRecipientName}" Placeholder="Payee name" />
            <Entry Text="{Binding NewHolder}" Placeholder="Account holder" />
            <Entry Text="{Binding NewBank}" Placeholder="Bank name" />
            <Entry Text="{Binding NewRouting}" Placeholder="Routing (9 digits)" Keyboard="Numeric" MaxLength="9" />
            <Entry Text="{Binding NewAccount}" Placeholder="Account number" Keyboard="Numeric" />
            <Picker Title="Account type" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding NewAccountType}" />
            <Entry Text="{Binding NewMemo}" Placeholder="Memo (optional)" />
            <Button Text="Save payee" Command="{Binding AddRecipientCommand}" />

            <Entry Text="{Binding Amount}" Placeholder="Amount" Keyboard="Numeric" />
            <Picker Title="Speed" SelectedItem="{Binding Speed}">
              <Picker.Items>
                <x:String>instant</x:String>
                <x:String>ach</x:String>
              </Picker.Items>
            </Picker>
            <Button Text="Send" Command="{Binding SendCommand}" />
          </VerticalStackLayout>
        </controls:GlassCard.Body>
      </controls:GlassCard>
    </VerticalStackLayout>
  </ScrollView>
  <controls:CoraFab ScreenKey="send" AutomationId="CoraFab" />
  </Grid>
</ContentPage>
