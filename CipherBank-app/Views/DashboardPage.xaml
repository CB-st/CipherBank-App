<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CipherBank_app.ViewModels"
             xmlns:models="clr-namespace:CipherBank_app.Models"
             xmlns:models1="clr-namespace:CipherBank_app.Models;assembly=CipherBank-app.Core"
             x:Class="CipherBank_app.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Dashboard">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshPricesCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header -->
                <Label x:Name="WelcomeLabel"
                       AutomationId="WelcomeLabel"
                       Text="Market Overview"
                       Style="{StaticResource PageHeader}"
                       HorizontalOptions="Start" />

                <Label x:Name="TotalBalanceLabel"
                       AutomationId="TotalBalanceLabel"
                       Text="{Binding TotalPortfolioValue, StringFormat='Portfolio: ${0:N2}'}"
                       FontSize="16"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,-8,0,8" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="50" />

                <!-- Error Message -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                        Style="{StaticResource WarningBanner}">
                    <Label x:Name="ErrorLabel"
                           AutomationId="ErrorLabel"
                           Text="{Binding ErrorMessage}"
                           Style="{StaticResource WarningBannerText}" />
                </Border>

                <!-- Cryptocurrency List -->
                <CollectionView x:Name="CryptocurrenciesList"
                               AutomationId="RecentTransactionsList"
                               ItemsSource="{Binding Cryptocurrencies}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedCrypto}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models1:CryptoCurrency">
                            <Border Margin="0,4"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DashboardViewModel}}, Path=ViewCryptoDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark=#3D2B7A}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <!-- Icon placeholder -->
                                    <Border Grid.Column="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            StrokeShape="RoundRectangle 24"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource IconPlaceholderBackground}, Dark={StaticResource IconPlaceholderBackgroundDark}}"
                                            Padding="0">
                                        <Label Text="{Binding Symbol, StringFormat='{0:0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Name and Symbol -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Symbol}"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryText}" />
                                    </VerticalStackLayout>

                                    <!-- Price and Change -->
                                    <VerticalStackLayout Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End"
                                                         Spacing="2">
                                        <Label Text="{Binding FormattedPrice}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding FormattedPercentChange}"
                                               FontSize="12"
                                               HorizontalTextAlignment="End"
                                               TextColor="{Binding IsPriceUp, Converter={StaticResource PriceChangeColorConverter}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Padding="40">
                            <Label Text="No cryptocurrencies available"
                                   FontSize="16"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalTextAlignment="Center" />
                            <Button x:Name="RefreshButton"
                                    AutomationId="RefreshButton"
                                    Text="Refresh"
                                    Command="{Binding LoadPricesCommand}"
                                    Margin="0,20,0,0" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Quick Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            x:Name="PurchaseButton"
                            AutomationId="PurchaseButton"
                            Text="Buy Crypto"
                            Command="{Binding NavigateToPurchaseCommand}"
                            CornerRadius="8"
                            HeightRequest="50" />

                    <Button Grid.Column="1"
                            x:Name="WalletButton"
                            AutomationId="WalletButton"
                            Text="My Wallets"
                            Command="{Binding NavigateToWalletsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="50" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
