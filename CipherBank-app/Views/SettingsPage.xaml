<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CipherBank_app.ViewModels"
             x:Class="CipherBank_app.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout x:Name="SettingsLayout" Padding="16" Spacing="16">

            <!-- API Settings -->
            <Border x:Name="ApiSettingsCard" StrokeShape="RoundRectangle 12" Padding="16" Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="API Configuration"
                           Style="{StaticResource SectionHeader}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="API Endpoint"
                               FontSize="12"
                               Style="{StaticResource SecondaryText}" />
                        <Entry Placeholder="https://api.cipherbank.money"
                               Text="{Binding ApiEndpoint}"
                               Keyboard="Url" />
                    </VerticalStackLayout>

                    <Button Text="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource SecondaryButton}" />

                    <ActivityIndicator IsRunning="{Binding IsTesting}"
                                       IsVisible="{Binding IsTesting}"
                                       HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

            <!-- Developer Mode card (DEBUG only) is added in code-behind so it is absent from Release builds. -->

            <!-- Appearance Settings -->
            <Border StrokeShape="RoundRectangle 12" Padding="16" Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Appearance"
                           Style="{StaticResource SectionHeader}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Theme"
                               FontSize="12"
                               Style="{StaticResource SecondaryText}" />
                        <Picker Title="Select theme"
                                ItemsSource="{Binding ThemeModes}"
                                SelectedItem="{Binding ThemeMode}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Default Currency"
                               FontSize="12"
                               Style="{StaticResource SecondaryText}" />
                        <Picker Title="Select currency"
                                ItemsSource="{Binding Currencies}"
                                SelectedItem="{Binding DefaultCurrency}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Security Settings -->
            <Border StrokeShape="RoundRectangle 12" Padding="16" Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Security"
                           Style="{StaticResource SectionHeader}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Biometric Authentication"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding BiometricEnabled}" />
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Auto-Lock Timeout"
                               FontSize="12"
                               Style="{StaticResource SecondaryText}" />
                        <Picker Title="Select timeout"
                                ItemsSource="{Binding AutoLockOptions}"
                                SelectedItem="{Binding AutoLockTimeout}" />
                        <Label Text="Minutes until auto-lock (0 = disabled)"
                               FontSize="11"
                               Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Notifications -->
            <Border StrokeShape="RoundRectangle 12" Padding="16" Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Notifications"
                           Style="{StaticResource SectionHeader}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Push Notifications"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding NotificationsEnabled}" />
                    </Grid>

                    <Label Text="Receive alerts for price changes and transactions."
                           FontSize="11"
                           Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Status Message -->
            <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                    Padding="12"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    BackgroundColor="{Binding IsStatusSuccess, Converter={StaticResource StatusColorConverter}}">
                <Label Text="{Binding StatusMessage}"
                       HorizontalTextAlignment="Center" />
            </Border>

            <!-- Action Buttons -->
            <Button Text="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                    FontAttributes="Bold"
                    HeightRequest="50" />

            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               HeightRequest="30" />

            <Button Text="Reset to Defaults"
                    Command="{Binding ResetToDefaultsCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonWarning}, Dark={StaticResource ButtonWarningDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource QuickAmountText}, Dark={StaticResource QuickAmountTextDark}}"
                    CornerRadius="8"
                    HeightRequest="44" />

            <!-- Account Section -->
            <Border StrokeShape="RoundRectangle 12" Padding="16" Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Margin="0,8,0,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Account"
                           Style="{StaticResource SectionHeader}" />

                    <Button Text="Log Out"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource DangerButton}"
                            HeightRequest="44" />

                    <Button Text="About CipherBank"
                            Command="{Binding ShowAboutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Version Info (tap 3 times for dev mode; gesture wired in code-behind, DEBUG only) -->
            <Label x:Name="VersionLabel"
                   Text="Version 1.0.0"
                   FontSize="12"
                   Style="{StaticResource SecondaryText}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
