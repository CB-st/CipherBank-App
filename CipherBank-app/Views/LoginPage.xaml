<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:viewmodels="clr-namespace:CipherBank_app.ViewModels"
             x:Class="CipherBank_app.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             ios:Page.UseSafeArea="True">

    <Grid x:Name="RootGrid">
        <!-- Environment badge (DEBUG only) is added in code-behind so it is absent from Release builds. -->
        <ScrollView>
            <VerticalStackLayout
                x:Name="LoginFormLayout"
                Padding="24,0"
                Spacing="24"
                VerticalOptions="Center">

                <!-- App Logo -->
                <Image Source="logo.png"
                       HeightRequest="80"
                       WidthRequest="80"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0" />

                <!-- App Title -->
                <Label
                    Text="CipherBank"
                    FontSize="32"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="0,0,0,0" />

                <Label
                    Text="Welcome Back"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Margin="0,0,0,40" />

                <!-- Username Entry -->
                <Border
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10"
                    Margin="0,10">
                    <Entry
                        x:Name="UsernameEntry"
                        AutomationId="UsernameEntry"
                        Placeholder="Username"
                        Text="{Binding Username}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        ReturnType="Next"
                        Completed="OnUsernameCompleted" />
                </Border>

                <!-- Password Entry -->
                <Border
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10"
                    Margin="0,10">
                    <Entry
                        x:Name="PasswordEntry"
                        AutomationId="PasswordEntry"
                        Placeholder="Password"
                        Text="{Binding Password}"
                        IsPassword="True"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        ReturnType="Done"
                        Completed="OnPasswordCompleted" />
                </Border>

                <!-- Error Message -->
                <Label
                    x:Name="ErrorLabel"
                    AutomationId="ErrorLabel"
                    Text="{Binding ErrorMessage}"
                    TextColor="{AppThemeBinding Light={StaticResource DangerText}, Dark={StaticResource DangerTextDark}}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    HorizontalOptions="Center"
                    Margin="0,10" />

                <!-- Sign In Button -->
                <Button
                    x:Name="LoginButton"
                    AutomationId="LoginButton"
                    Text="Sign In"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HorizontalOptions="Fill"
                    Margin="0,20"
                    Padding="0,15" />

                <!-- "Use Test Credentials" button (DEBUG only) is added in code-behind. -->

                <!-- Loading Indicator -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center"
                    Margin="0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
