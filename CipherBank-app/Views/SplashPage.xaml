<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherBank_app.Views.SplashPage"
             Title="Splash"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="{StaticResource Ink}"
             AutomationId="SplashPage">
  <VerticalStackLayout VerticalOptions="Center"
                       HorizontalOptions="Center"
                       Spacing="20">
    <Image Source="logo.png"
           HeightRequest="64"
           WidthRequest="64"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           SemanticProperties.Description="CipherBank" />
    <Label x:Name="StatusLabel"
           Text="Securing your session…"
           Style="{StaticResource MonoCaption}"
           CharacterSpacing="1"
           TextColor="{StaticResource OnDarkSubtle}"
           HorizontalTextAlignment="Center"
           AutomationId="SplashStatusLabel" />
  </VerticalStackLayout>
</ContentPage>
