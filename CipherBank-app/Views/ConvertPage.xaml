<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CipherBank_app.Controls"
             x:Class="CipherBank_app.Views.ConvertPage"
             Title="Convert"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="{Binding CoraLine}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
      <controls:GlassCard>
        <controls:GlassCard.Body>
          <VerticalStackLayout Spacing="10">
            <Entry Text="{Binding FromAsset}" Placeholder="From" />
            <Entry Text="{Binding ToAsset}" Placeholder="To" />
            <Entry Text="{Binding Amount}" Placeholder="Amount" Keyboard="Numeric" />
            <Label Text="{Binding RateText}" FontFamily="ManropeSemiBold" />
            <Label Text="{Binding LockCountdown}" FontSize="12" />
            <Button Text="Lock quote" Command="{Binding LockQuoteCommand}" AutomationId="ConvertLockQuoteButton" />
            <Button Text="Convert" Command="{Binding ConvertCommand}" IsEnabled="{Binding HasValidLock}" AutomationId="ConvertSubmitButton" />
            <Label Text="{Binding Status}" />
          </VerticalStackLayout>
        </controls:GlassCard.Body>
      </controls:GlassCard>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
