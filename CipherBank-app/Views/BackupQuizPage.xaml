<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CipherBank_app.Views.BackupQuizPage"
             Title="Confirm backup"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">

      <Label Text="Confirm 3 words from your recovery phrase"
             FontFamily="ManropeSemiBold"
             FontSize="18" />

      <CollectionView ItemsSource="{Binding Rows}">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <VerticalStackLayout Spacing="6" Padding="0,0,0,10">
              <Label Text="{Binding Prompt}" FontFamily="ManropeSemiBold" />
              <Entry Text="{Binding Answer}" Placeholder="word" />
            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label Text="{Binding Error}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
      <Button Text="Verify" Command="{Binding VerifyCommand}" />

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
