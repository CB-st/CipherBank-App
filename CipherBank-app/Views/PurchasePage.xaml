<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CipherBank_app.ViewModels"
             xmlns:models="clr-namespace:CipherBank_app.Models"
             x:Class="CipherBank_app.Views.PurchasePage"
             x:DataType="viewmodels:PurchaseViewModel"
             Title="Buy Crypto">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Header -->
            <Label Text="Purchase Cryptocurrency"
                   Style="{StaticResource PageHeader}"
                   HorizontalOptions="Center" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               HeightRequest="40" />

            <!-- Error Message -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    Style="{StaticResource WarningBanner}">
                <Label x:Name="ErrorLabel"
                       AutomationId="ErrorLabel"
                       Text="{Binding ErrorMessage}"
                       Style="{StaticResource WarningBannerText}" />
            </Border>

            <!-- Crypto Selection -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Select Cryptocurrency"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Picker x:Name="CryptoSelector"
                            AutomationId="CryptoSelector"
                            Title="Choose a cryptocurrency"
                            ItemsSource="{Binding AvailableCryptos}"
                            SelectedItem="{Binding SelectedCrypto}"
                            ItemDisplayBinding="{Binding Name}" />

                    <!-- Selected Crypto Info -->
                    <Border IsVisible="{Binding SelectedCrypto, Converter={StaticResource ObjectToBoolConverter}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource SurfaceSecondaryDark}}"
                            Padding="12"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding SelectedCrypto.Name}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SelectedCrypto.Symbol}"
                                       FontSize="12"
                                       Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="{Binding SelectedCrypto.FormattedPrice}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SelectedCrypto.FormattedPercentChange}"
                                       FontSize="12"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Amount Input -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    IsVisible="{Binding SelectedCrypto, Converter={StaticResource ObjectToBoolConverter}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Enter Amount"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               x:Name="AmountEntry"
                               AutomationId="AmountEntry"
                               Placeholder="0.00000000"
                               Text="{Binding AmountText}"
                               Keyboard="Numeric"
                               FontSize="20"
                               IsEnabled="{Binding IsPurchasing, Converter={StaticResource InvertedBoolConverter}}" />
                        <Label Grid.Column="1"
                               Text="{Binding SelectedCrypto.Symbol}"
                               FontSize="20"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Quick Amount Buttons -->
                    <Label Text="Quick amounts (USD)"
                           FontSize="12"
                           Style="{StaticResource SecondaryText}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="$25"
                                Command="{Binding SetPresetAmountCommand}"
                                CommandParameter="25"
                                Style="{StaticResource QuickAmountButton}" />
                        <Button Text="$50"
                                Command="{Binding SetPresetAmountCommand}"
                                CommandParameter="50"
                                Style="{StaticResource QuickAmountButton}" />
                        <Button Text="$100"
                                Command="{Binding SetPresetAmountCommand}"
                                CommandParameter="100"
                                Style="{StaticResource QuickAmountButton}" />
                        <Button Text="$500"
                                Command="{Binding SetPresetAmountCommand}"
                                CommandParameter="500"
                                Style="{StaticResource QuickAmountButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Order Summary -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Stroke="Transparent"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark={StaticResource SurfaceSecondaryDark}}"
                    IsVisible="{Binding SelectedCrypto, Converter={StaticResource ObjectToBoolConverter}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Order Summary"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Amount"
                               Style="{StaticResource SecondaryText}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Amount, StringFormat='{0:F8}'}"
                               HorizontalTextAlignment="End" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Price per unit"
                               Style="{StaticResource SecondaryText}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedCrypto.FormattedPrice}"
                               HorizontalTextAlignment="End" />

                        <Label Grid.Row="2" Grid.Column="0"
                               Text="Fee (1.5%)"
                               Style="{StaticResource SecondaryText}" />
                        <Label Grid.Row="2" Grid.Column="1"
                               x:Name="FeeLabel"
                               AutomationId="FeeLabel"
                               Text="{Binding Fee, StringFormat='${0:F2}'}"
                               HorizontalTextAlignment="End" />

                        <BoxView Grid.Row="3" Grid.ColumnSpan="2"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Grid.Column="0"
                               Text="Total"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding TotalCost, StringFormat='${0:F2}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Purchase Button -->
            <Button x:Name="PurchaseButton"
                    AutomationId="PurchaseButton"
                    Text="Purchase"
                    Command="{Binding PurchaseCryptoCommand}"
                    IsEnabled="{Binding IsPurchasing, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding SelectedCrypto, Converter={StaticResource ObjectToBoolConverter}}"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="12"
                    HeightRequest="56"
                    Margin="0,8" />

            <!-- Purchasing Indicator -->
            <ActivityIndicator IsRunning="{Binding IsPurchasing}"
                               IsVisible="{Binding IsPurchasing}"
                               HorizontalOptions="Center"
                               HeightRequest="40" />

            <!-- Disclaimer -->
            <Label Text="Cryptocurrency trading involves significant risk. Past performance does not guarantee future results."
                   FontSize="11"
                   Style="{StaticResource SecondaryText}"
                   HorizontalTextAlignment="Center"
                   Margin="16,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
