<?xml version="1.0" encoding="utf-8"?>
<!--
===================================================================================
Certificate pinning — blocked until ops publishes real SPKI hashes
===================================================================================
Do NOT ship REPLACE_WITH_* placeholder digests: Android pin-sets with fake pins
break TLS to api.cipherbank.money / api.sandbox.cipherbank.money.

Until production + backup pins are published, those hosts trust the system CA
store (same posture as api.dev). When pins land, restore <pin-set> blocks here.

To obtain pins:
  openssl s_client -servername api.cipherbank.money -connect api.cipherbank.money:443 < /dev/null 2>/dev/null | \
    openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | \
    openssl dgst -sha256 -binary | openssl enc -base64

Always include a backup pin for certificate rotation.
===================================================================================
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Local lab cleartext (emulator host loopback). Keep off production API hosts. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>

  <!-- Prod / sandbox / dev: system CAs until real pin sets are published. -->
  <domain-config>
    <domain includeSubdomains="true">api.cipherbank.money</domain>
    <domain includeSubdomains="true">api.sandbox.cipherbank.money</domain>
    <domain includeSubdomains="true">api.dev.cipherbank.money</domain>
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </domain-config>
</network-security-config>
