<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CipherBank_app</RootNamespace>
    <!-- Prototype Core: known analyzer noise on net10 + dense modules.
         Keep visible as warnings; do not fail the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SA1402;SA1649;SA1201;SA1204;SA1202;SA1516;SA1407;SA1515;SA1507;CA1707;CA1711;CA1716;CA1859;IDE0005</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <!-- Pin past NU1903 (2.1.11) but exclude ALL assets — desktop Linux natives
         (libc.so.6) must never land in the Android APK or SqliteConnection type-init fails.
         Android natives come only from sqlitepclraw.lib.e_sqlite3.android below.
         CipherBank-app.Tests references the desktop package without ExcludeAssets. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="NBitcoin" Version="8.0.13" />
    <PackageReference Include="NBitcoin.Altcoins" Version="3.0.33" />
    <PackageReference Include="Nethereum.HdWallet" Version="6.1.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custody storage-key constants stay internal; the unit suite needs them to seed legacy blobs. -->
    <InternalsVisibleTo Include="CipherBank-app.Tests" />
  </ItemGroup>

</Project>
