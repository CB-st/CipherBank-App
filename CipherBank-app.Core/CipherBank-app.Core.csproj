<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CipherBank_app</RootNamespace>
    <!-- Phase 3: SA1402/SA1649 removed after Stage 2 one-type-per-file splits. -->
    <!-- Phase 3 Stage 3: SA1402/SA1649 removed. CA1707 kept for RootNamespace CipherBank_app (assembly-aligned). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0005</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);IDE0005;CA1707</NoWarn>
    <Company>CipherBank</Company>
    <Product>CipherBank App Core</Product>
    <Description>Platform-neutral CipherBank domain and application services.</Description>
    <RepositoryUrl>https://github.com/CB-st/CipherBank-App</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- Microsoft.Data.Sqlite transitively pulls SQLitePCLRaw.bundle_e_sqlite3; exclude it
         (and the desktop lib) so Android APKs only get sqlitepclraw.lib.e_sqlite3.android.
         CipherBank-app.Tests references the desktop package without ExcludeAssets. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="NBitcoin" />
    <PackageReference Include="NBitcoin.Altcoins" />
    <PackageReference Include="Nethereum.HdWallet" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custody storage-key constants stay internal; the unit suite needs them to seed legacy blobs. -->
    <InternalsVisibleTo Include="CipherBank-app.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\config\security\cryptography.json"
                      Link="config\security\cryptography.json"
                      LogicalName="CipherBank_app.Config.security.cryptography.json" />
    <EmbeddedResource Include="..\config\dispatch\sync-scheduler.json"
                      Link="config\dispatch\sync-scheduler.json"
                      LogicalName="CipherBank_app.Config.dispatch.sync-scheduler.json" />
    <EmbeddedResource Include="..\config\persistence\database.json"
                      Link="config\persistence\database.json"
                      LogicalName="CipherBank_app.Config.persistence.database.json" />
    <EmbeddedResource Include="..\config\network\endpoints.json"
                      Link="config\network\endpoints.json"
                      LogicalName="CipherBank_app.Config.network.endpoints.json" />
    <EmbeddedResource Include="..\config\ui\cora-lines.json"
                      Link="config\ui\cora-lines.json"
                      LogicalName="CipherBank_app.Config.ui.cora-lines.json" />
    <EmbeddedResource Include="..\config\ui\carousel.json"
                      Link="config\ui\carousel.json"
                      LogicalName="CipherBank_app.Config.ui.carousel.json" />
  </ItemGroup>


</Project>
