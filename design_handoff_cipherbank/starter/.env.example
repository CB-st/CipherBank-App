# Cipherbank app env
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_API_BASE=https://api.cipherbank.dev/v1
EXPO_PUBLIC_WSS=wss://api.cipherbank.dev/v1/stream
# Public PriceCache API (SCREAMING_SNAKE · POST /currencies · /quote · /iquote · /test) — not under /v1
EXPO_PUBLIC_PUBLIC_API_BASE=https://api.cipherbank.money
# Clean OOTB (default). Set SEED_DEMO=true for lab: demo custody PIN 000000, ACH payees, rich portfolio.
EXPO_PUBLIC_SEED_DEMO=false
# Legacy alias for SEED_DEMO — prefer EXPO_PUBLIC_SEED_DEMO
EXPO_PUBLIC_MOCK_HAS_WALLET=false
EXPO_PUBLIC_HARDWARE_CARD_ID=card_tok_nfc_bench_4242
EXPO_PUBLIC_POS_REQUIRE_TEST_CARD=true
