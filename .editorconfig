# EditorConfig for CipherBank-app
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_size = 4

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Use file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion

# Use 'var' when type is apparent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Prefer expression-bodied members when single line
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# Prefer pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# Null checking preferences
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# Code block preferences
csharp_prefer_braces = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# Expression preferences
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Naming conventions

# Interfaces should begin with I
dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Private fields should be _camelCase
dotnet_naming_rule.private_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_with_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_with_underscore.required_prefix = _
dotnet_naming_style.camel_case_with_underscore.capitalization = camel_case

# Constants should be PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Async methods should end with Async
dotnet_naming_rule.async_methods_should_end_with_async.severity = suggestion
dotnet_naming_rule.async_methods_should_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_should_end_with_async.style = end_with_async
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_with_async.required_suffix = Async
dotnet_naming_style.end_with_async.capitalization = pascal_case

# Code quality
dotnet_code_quality_unused_parameters = all:suggestion
dotnet_remove_unnecessary_suppression_exclusions = none

# IDE warnings
dotnet_diagnostic.IDE0005.severity = warning  # Remove unnecessary usings
dotnet_diagnostic.IDE0044.severity = suggestion  # Make field readonly
dotnet_diagnostic.IDE0051.severity = warning  # Remove unused private member
dotnet_diagnostic.IDE0052.severity = warning  # Remove unread private member

# Security warnings
dotnet_diagnostic.CA2100.severity = error  # SQL injection
dotnet_diagnostic.CA2109.severity = error  # Review visible event handlers
dotnet_diagnostic.CA5350.severity = error  # Do not use weak crypto
dotnet_diagnostic.CA5351.severity = error  # Do not use broken crypto
dotnet_diagnostic.CA5359.severity = error  # Do not disable certificate validation

# Suppress StyleCop rules that conflict with modern C# and project conventions
dotnet_diagnostic.SA1101.severity = none   # Don't require 'this.' prefix — modern C# convention
dotnet_diagnostic.SA1309.severity = none   # Allow _camelCase private fields — matches project naming rules above
dotnet_diagnostic.SA1200.severity = none   # Allow usings outside namespace — required for file-scoped namespaces
dotnet_diagnostic.SA0001.severity = none   # Don't require XML comment analysis on all files

# ---------------------------------------------------------------------------
# SonarAnalyzer.CSharp (csharpsquid) — aligns local lint with SonarQube gate.
# Severities follow docs/SONAR_GATE.md. Deferred rules are silenced so they do
# not block TreatWarningsAsErrors when EnableSonarAnalyzers=true.
# Enable via: ./scripts/lint-csharp.sh  or  -p:EnableSonarAnalyzers=true
# ---------------------------------------------------------------------------

# P0 reliability — fail local lint (true bugs)
dotnet_diagnostic.S1244.severity = error
dotnet_diagnostic.S3923.severity = error
dotnet_diagnostic.S6966.severity = error

# P1 / signal maintainability — warn locally (CI Sonar gate still enforces new_violations).
# Use ./scripts/lint-csharp.sh --strict to fail the build on these.
dotnet_diagnostic.S1541.severity = warning
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S2339.severity = warning
dotnet_diagnostic.S2360.severity = warning
dotnet_diagnostic.S2365.severity = warning
dotnet_diagnostic.S1067.severity = warning
dotnet_diagnostic.S3218.severity = warning
dotnet_diagnostic.S107.severity = warning
dotnet_diagnostic.S109.severity = warning
dotnet_diagnostic.S3358.severity = warning
dotnet_diagnostic.S4457.severity = warning
dotnet_diagnostic.S3906.severity = warning
dotnet_diagnostic.S3994.severity = warning
dotnet_diagnostic.S3995.severity = warning
dotnet_diagnostic.S3996.severity = warning
dotnet_diagnostic.S3376.severity = warning
dotnet_diagnostic.S8969.severity = warning
dotnet_diagnostic.S6608.severity = warning

# Previously deferred — now in burndown scope (warn until fixed; --strict fails)
dotnet_diagnostic.S6354.severity = warning
dotnet_diagnostic.S4055.severity = warning
dotnet_diagnostic.S4004.severity = warning
dotnet_diagnostic.S3956.severity = warning
dotnet_diagnostic.S4136.severity = warning

# UserPrefs must keep collection setters for PrefsStore STJ replace semantics (see SONAR_GATE.md)
[CipherBank-app.Core/Persist/UserPrefs.cs]
dotnet_diagnostic.S4004.severity = none

# StyleCop structural residuals — warn during burndown
[*.{cs,csx}]
dotnet_diagnostic.SA1402.severity = warning
dotnet_diagnostic.SA1201.severity = warning
dotnet_diagnostic.SA1649.severity = warning
dotnet_diagnostic.SA1636.severity = warning
dotnet_diagnostic.SA1107.severity = warning
dotnet_diagnostic.SA1516.severity = warning

# IDE convention lock (Phase 7) — prefer var when type is apparent; silence flip-flop pair
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0007.severity = suggestion
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0021.severity = suggestion
dotnet_diagnostic.IDE0022.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion

# Residual MINOR / INFO — suggestion (do not fail --strict after cluster burn)
dotnet_diagnostic.S2221.severity = suggestion
dotnet_diagnostic.S3242.severity = suggestion
dotnet_diagnostic.S1227.severity = suggestion
dotnet_diagnostic.S3240.severity = suggestion
dotnet_diagnostic.S4040.severity = suggestion
dotnet_diagnostic.S4261.severity = suggestion
dotnet_diagnostic.S4056.severity = suggestion

# SQL / schema CommandText is not UI copy — keep S4055 as warning for true user strings only;
# Persist repositories may still report SQL literals; treat as suggestion until dedicated SQL constants pass.
[CipherBank-app.Core/Persist/WalletRepository.cs]
dotnet_diagnostic.S4055.severity = none

[CipherBank-app.Core/Persist/RecipientRepository.cs]
dotnet_diagnostic.S4055.severity = none

[CipherBank-app.Core/Persist/MarketRepository.cs]
dotnet_diagnostic.S4055.severity = none

[CipherBank-app.Core/Persist/PrefsStore.cs]
dotnet_diagnostic.S4055.severity = none

[CipherBank-app.Core/Persist/RatesCache.cs]
dotnet_diagnostic.S4055.severity = none

[CipherBank-app.Core/Persist/LocalDb.cs]
dotnet_diagnostic.S4055.severity = none

# Test-injected System.Random for deterministic BackupQuiz; production uses RandomNumberGenerator.
[CipherBank-app.Core/Custody/BackupQuiz.cs]
dotnet_diagnostic.CA5394.severity = none

# XML files
[*.{xml,xaml,csproj,props,targets}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
end_of_line = lf
