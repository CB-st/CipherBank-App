# Org-default clang-tidy config for CipherBank Cursor checkouts.
# Used by scripts/lint-cpp.sh. Prefer a repo-root .clang-tidy when present.
# Policy: docs/LOCAL_LINT.md

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  modernize-*,
  -modernize-use-trailing-return-type

# Fail the lint gate on configured diagnostics (not advisory-only).
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
FormatStyle: file
